{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dfin-monorepo",
  "version": "0.1.0",
  "identifier": "com.user.dfin-monorepo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DFIN",
        "width": 800,
        "height": 600,
        "label": "main"
      },
      {
        "title": "DFIN Session",
        "width": 320,
        "height": 500,
        "label": "session-widget",
        "url": "/widget",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
